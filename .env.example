# Copy this file to .env and adjust values as needed.
# None of these are secrets - this project uses no external paid APIs -
# they simply make file paths and pipeline knobs configurable.

# Paths (defaults are fine for local use, override for custom layouts)
DATA_RAW_PATH=data/raw/accidents.csv
DATA_PROCESSED_PATH=data/processed/accidents_clean.csv
MODEL_DIR=models

# Reproducibility
RANDOM_SEED=42

# Synthetic data generator (used only when no real dataset is supplied)
N_SYNTHETIC_RECORDS=20000

# Hotspot detection tuning
KMEANS_K=12
DBSCAN_EPS_KM=1.5
DBSCAN_MIN_SAMPLES=8
KDE_BANDWIDTH=0.02
TOP_N_HOTSPOTS=25

# Streamlit
STREAMLIT_SERVER_PORT=8501
